{
  "manifest_version": 3,
  "name": "Patreon Archiver",
  "version": "1.0.0",
  "description": "Downloads text, images, videos, and attachments in an organized, structured format.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "scripting",
    "activeTab",
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://*.patreon.com/*",
    "https://*.patreonusercontent.com/*",
    "https://*.ytimg.com/*",
    "https://*.youtube.com/*",
    "https://*.vimeocdn.com/*",
    "https://*.onedrive.live.com/*",
    "https://1drv.ms/*",
    "https://*.mediafire.com/*",
    "https://*.wetransfer.com/*",
    "https://we.tl/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.patreon.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/i18n.js", "icons/icon128.png"],
      "matches": ["https://*.patreon.com/*"]
    },
    {
      "resources": ["lib/i18n.js", "lib/nativeHost.js", "icons/icon128.png"],
      "matches": ["chrome-extension://*/*"]
    }
  ]
}
